# Prevent this folder from ever being served directly by the browser.
# database.php contains DB credentials and should only ever be loaded
# via PHP's require/include — never requested as a URL.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
